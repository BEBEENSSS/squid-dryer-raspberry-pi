{
  "rules": {
    "devices": {
      "$deviceId": {
        ".read": "auth != null && auth.uid === 'MmpK3i6OsnR6RbSGMRHm2M9U5cJ2'",
        "commands": {
          ".write": "auth != null && auth.uid === 'MmpK3i6OsnR6RbSGMRHm2M9U5cJ2'",
          "fan": { ".validate": "newData.isBoolean()" },
          "heater": { ".validate": "newData.isBoolean()" },
          "$other": { ".validate": false }
        },
        "settings": {
          ".write": "auth != null && auth.uid === 'MmpK3i6OsnR6RbSGMRHm2M9U5cJ2'",
          ".validate": "newData.hasChildren(['updated_at'])",
          "safe_temp_c": { ".validate": "newData.isNumber() && newData.val() >= 25 && newData.val() <= 50" },
          "heater_cutoff_c": { ".validate": "newData.isNumber() && newData.val() >= 30 && newData.val() <= 58" },
          "manual_target_temp_c": { ".validate": "newData.isNumber() && newData.val() >= 30 && newData.val() <= 55" },
          "manual_target_humidity": { ".validate": "newData.isNumber() && newData.val() >= 20 && newData.val() <= 80" },
          "updated_at": { ".validate": "newData.val() == now" },
          "$other": { ".validate": false }
        },
        "task": {
          "request": {
            ".write": "auth != null && auth.uid === 'MmpK3i6OsnR6RbSGMRHm2M9U5cJ2'",
            ".validate": "newData.hasChildren(['command', 'requested_at'])",
            "command": { ".validate": "newData.isString() && newData.val().matches(/^(start|add_batch|complete_batch|cancel|resume|abort|acknowledge)$/)" },
            "task_id": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{1,64}$/)" },
            "command_id": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128" },
            "requested_at": { ".validate": "newData.val() == now" },
            "duration_minutes": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 10080" },
            "batch_count": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100" },
            "row_levels": { ".validate": "newData.isString() && newData.val().length <= 64 && newData.val().matches(/^[0-9]+( *, *[0-9]+)*$/)" },
            "batch_id": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{1,64}$/)" },
            "weight_kg": { ".validate": "newData.isNumber() && newData.val() > 0" },
            "requested_by": { ".validate": "newData.isString() && newData.val().length <= 128" },
            "$other": { ".validate": false }
          }
        }
      }
    }
  }
}
